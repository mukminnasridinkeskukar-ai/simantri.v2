# ============================================================================
# SIMANTRI v2 — Environment Variables
# ============================================================================
# Salin file ini ke `.env` untuk development lokal, atau set sebagai
# Repository Secrets di GitHub untuk production.
#
# PENTING:
#   - JANGAN pernah commit file .env yang berisi credentials asli
#   - Hanya ANON KEY yang aman untuk frontend (RLS yang melindungi data)
#   - SERVICE ROLE KEY JANGAN dipakai di frontend — hanya di Edge Functions
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE (wajib untuk production, opsional untuk demo)
# ----------------------------------------------------------------------------
# Ambil dari: Supabase Dashboard → Project Settings → API
# - URL:    https://YOUR-PROJECT-REF.supabase.co
# - Anon:   "anon public" key (BUKAN "service_role")

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ----------------------------------------------------------------------------
# 2. APP INFO (opsional)
# ----------------------------------------------------------------------------
VITE_APP_NAME=SIMANTRI
VITE_APP_TAGLINE=Sistem Informasi & Manajemen Praktik Nakes

# ----------------------------------------------------------------------------
# 3. BASE PATH (penting untuk GitHub Pages)
# ----------------------------------------------------------------------------
# Base path menentukan prefix URL untuk semua asset (CSS, JS, gambar).
#
# Kasus 1 — User/Organization page (https://USERNAME.github.io/):
#   VITE_BASE_PATH=/
#
# Kasus 2 — Project page (https://USERNAME.github.io/REPO-NAME/):
#   VITE_BASE_PATH=/REPO-NAME/
#   Contoh: VITE_BASE_PATH=/simantri-nakes-v2/
#
# Kasus 3 — Development lokal (npm run dev):
#   TIDAK perlu set VITE_BASE_PATH (otomatis '/')
#
# Kasus 4 — Kosong / tidak diset:
#   Build akan pakai './' (relative) — kompatibel di mana saja
#
# Di GitHub Actions, VITE_BASE_PATH otomatis di-set dari nama repo
# (lihat .github/workflows/deploy.yml) — jadi TIDAK perlu set manual.
#
# Set manual hanya jika Anda build lokal untuk deploy ke subpath tertentu:
VITE_BASE_PATH=
